# =============================================================================
# NEO Monitor - Variáveis de Ambiente (.env)
# Copie este arquivo para .env e preencha com seus dados:
#   cp .env.example .env
# =============================================================================

# Chave da NASA NeoWs API (gratuita em https://api.nasa.gov/)
NASA_API_KEY=DEMO_KEY

# -----------------------------------------------------------------------------
# OPÇÃO 1: Banco de Dados Local (Docker Compose ou PostgreSQL local)
# -----------------------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tcc_asteroides

# -----------------------------------------------------------------------------
# OPÇÃO 2: Banco de Dados na Nuvem (Supabase / Produção)
# Se preenchida, DATABASE_URL sobrepõe as 5 variáveis locais acima.
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://usuario:senha@host:5432/postgres?sslmode=require
